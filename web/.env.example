# Copy this file to web/.env.local and paste in the values from
# Firebase console → Project settings → Your apps → (web app) → SDK setup and configuration.
# These "web config" values are safe to expose in a browser; access is controlled by Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional – only needed for browser push notifications.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Set to true to use the local Firebase emulators (npm run emulators in the repo root) instead of the cloud.
VITE_USE_EMULATORS=false
