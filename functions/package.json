{
  "name": "broadside-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Functions backend for Broadside (server-validated naval combat game)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore \"vitest run --config vitest.emulator.config.mts\"",
    "test:all": "npm test && npm run test:emulator",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "~14.4.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.0"
  }
}
