rules_version = '2';

// Security model
// --------------
// * All game mutations go through Cloud Functions (Admin SDK bypasses these rules), so clients
//   get READ access only, except for their own push-token document.
// * games/{id} is readable only by its two players and never contains ship positions until the
//   game is finished (revealedFleets).
// * games/{id}/private/{uid} holds a player's fleet and is readable ONLY by that player. The
//   opponent – or anyone else – cannot read it, so a modified client cannot see where ships are.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Public profiles: needed for leaderboards, opponent names, and game history.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false; // created/updated by the setUsername + game Functions only

      // FCM tokens – the owner registers/removes their own device tokens.
      match /private/push {
        allow read: if isSelf(uid);
        allow write: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['tokens', 'updatedAt'])
          && request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 20;
      }

      // Phase 5 achievement shelf: public, like the profile. Written once by Functions.
      match /achievements/{achievementId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Phase 5 daily-challenge run: only the owner sees their shots.
      match /dailyRuns/{dateKey} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Who I've played against (drives the Friends leaderboard).
      match /opponents/{oppUid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Username uniqueness index. Availability is checked via the checkUsername Function.
    match /usernames/{name} {
      allow read, write: if false;
    }

    match /games/{gameId} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerUids;
      allow write: if false;

      // A player's hidden board. Only that player may read it; nobody may write from a client.
      match /private/{uid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // Quick-chat reactions are readable only by the game's players.
      match /reactions/{id} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.playerUids;
        allow write: if false;
      }

      // In-game chat is written through a rate-limited Function and read only by both players.
      match /messages/{id} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.playerUids;
        allow write: if false;
      }

      match /chatState/{uid} {
        allow read, write: if false;
      }
    }

    // Join-code lookup happens inside the joinGame Function so codes can't be enumerated.
    match /gameCodes/{code} {
      allow read, write: if false;
    }

    // Weekly leaderboard.
    match /weeklyWins/{weekId}/players/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Quick Match: a player may watch (and delete) only their own ticket.
    match /quickMatch/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if false;
    }

    // Direct challenges: visible to the two players involved. Created/answered via Functions only.
    // List queries must filter on fromUid == me or toUid == me.
    match /challenges/{challengeId} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow write: if false;
    }

    // Phase 5 per-mode stats: public, like the profile.
    match /playerStats/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Phase 5 head-to-head record: only the two players.
    match /headToHead/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerUids;
      allow write: if false;
    }

    // Phase 5 daily challenge: public definition (no fleet) and public scores.
    // gameEnds/* and dailyChallengesPrivate/* fall through to the deny-all below.
    match /dailyChallenges/{dateKey} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /dailyScores/{dateKey}/players/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
